# 复制本文件为 application-local.yml 并填入 DBA 分配的 03 组云数据库信息
# 注意：application-local.yml 已加入 .gitignore，切勿提交到代码仓库！

spring:
  datasource:
    url: jdbc:mysql://YOUR_DB_HOST:3306/course_grade_mgmt?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: YOUR_DB_USER
    password: YOUR_DB_PASSWORD
